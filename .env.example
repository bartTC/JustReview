# Notarization credentials (alternative to `just notary-setup`). Copy to .env, which git ignores.
APPLE_ID=you@example.com
# 10-character Team ID: developer.apple.com/account → Membership
APPLE_TEAM_ID=XXXXXXXXXX
# App-specific password: appleid.apple.com → Sign-In and Security → App-Specific Passwords
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
